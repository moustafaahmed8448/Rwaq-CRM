// Postgres is the single source of truth for both local dev and production.
// The JSON files under /data are legacy: they are read once by prisma/seed.ts
// and are no longer written to at runtime.
//
// Note: enum-typed columns were widened to String so the app can store
// user-defined channels (e.g. FORSA) and custom statuses (e.g. NEW).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model MarketingMetric {
  id          String   @id
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  channel     String
  spend       Decimal  @db.Decimal(12, 2)
  reach       Int      @default(0)
  impressions Int      @default(0)
  clicks      Int      @default(0)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([startDate, endDate, channel])
  @@index([startDate, endDate])
  @@index([channel])
}

model Client {
  id                  String    @id @default(uuid())
  createdAt           DateTime  @default(now())
  lastUpdateDate      DateTime  @updatedAt
  name                String
  phoneNumber         String
  status              String    @default("WAITING")
  project             String
  location            String
  acquisitionChannel  String
  operationToTake     String    @db.Text
  firstContactPerson  String
  secondContactPerson String
  notes               String?
  archived            Boolean   @default(false)
  archivedAt          DateTime?
  activityLog         Json?

  @@index([acquisitionChannel, createdAt])
  @@index([status])
  @@index([location])
  @@index([createdAt])
  @@index([archived])
}

model AppUser {
  id        String   @id @default(uuid()) @db.Uuid
  username  String   @unique
  name      String
  email     String?
  role      String   @default("Sales")
  hash      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id         String   @id @default(uuid())
  recipient  String
  type       String
  message    String
  clientId   String?
  clientName String?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([recipient, read])
  @@index([createdAt])
}

/// Key/value store for user-defined reference data: "channels", "statuses", "locations".
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model SyncRun {
  id             String    @id @default(uuid()) @db.Uuid
  provider       String
  direction      String
  status         String
  recordsRead    Int       @default(0)
  recordsWritten Int       @default(0)
  error          String?
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  @@index([provider, startedAt])
}

