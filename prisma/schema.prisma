// Postgres is the single source of truth for both local dev and production.
// The JSON files under /data are legacy: they are read once by prisma/seed.ts
// and are no longer written to at runtime.
//
// Note: enum-typed columns were widened to String so the app can store
// user-defined channels (e.g. FORSA) and custom statuses (e.g. NEW).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Prisma CLI work (db push / migrate / db pull) must bypass PgBouncer, so it
  // uses the direct connection instead of the pooled one above.
  //
  // This deliberately reads DATABASE_URL_UNPOOLED rather than a custom name
  // like DIRECT_URL: the Neon Vercel integration injects DATABASE_URL and
  // DATABASE_URL_UNPOOLED but NOT a custom DIRECT_URL, so naming it this way
  // is what lets `prisma generate` resolve this schema on Vercel with no
  // manual environment setup. Keep the name in sync with .env.example.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model MarketingMetric {
  id          String   @id
  // Campaign name. Nullable so existing rows need no backfill; a metric without
  // one is simply shown as "—" in the UI.
  name        String?
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  channel     String
  spend       Decimal  @db.Decimal(12, 2)
  reach       Int      @default(0)
  impressions Int      @default(0)
  clicks      Int      @default(0)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([startDate, endDate, channel])
  @@index([startDate, endDate])
  @@index([channel])
  @@index([name])
}

model Client {
  id                  String    @id @default(uuid()) @db.Uuid
  createdAt           DateTime  @default(now())
  lastUpdateDate      DateTime  @updatedAt
  name                String
  phoneNumber         String
  status              String    @default("WAITING")
  project             String
  location            String
  acquisitionChannel  String
  operationToTake     String    @db.Text
  firstContactPerson  String
  secondContactPerson String
  notes               String?
  // When this client should next be chased. Nullable on purpose: most rows have
  // no agreed follow-up yet, and "" cannot express "not set" the way null does.
  // Separate from `operationToTake`, which stays free text describing WHAT to do
  // ("Send price sheet"); this is only WHEN.
  nextFollowUpAt      DateTime?
  archived            Boolean   @default(false)
  archivedAt          DateTime?
  activityLog         Json?

  @@index([acquisitionChannel, createdAt])
  @@index([status])
  @@index([location])
  @@index([createdAt])
  @@index([archived])
  // Serves the "due / overdue" query, which filters on the date alone and sorts
  // by it. An unindexed date scan over the whole book is what made the dashboard
  // card slow before this existed.
  @@index([nextFollowUpAt])
}

model AppUser {
  id        String   @id @default(uuid()) @db.Uuid
  username  String   @unique
  name      String
  email     String?
  role      String   @default("Sales")
  hash      String
  language  String   @default("ar")
  /**
   * Per-user clients-table layout: column widths and visibility.
   * Sparse JSON — absent keys fall back to CLIENT_COLUMN_DEFAULTS, so a column
   * added later picks up its default instead of being stranded by a stale entry.
   */
  clientColumns Json?
  /**
   * Per-user marketing-table layout: column widths and visibility.
   * Separate from `clientColumns` on purpose — the two tables have unrelated
   * column sets, so sharing one blob would mean resizing a clients column
   * silently rewrote a marketing column of the same name.
   */
  marketingColumns Json?
  /**
   * Per-user users-table layout: column widths and visibility.
   * A third blob for the same reason as the second — the users grid has its own
   * keys (`role`, `username`) that the other two registries would reject, so a
   * shared blob would drop them on the round trip.
   */
  userColumns    Json?
  /**
   * Profile photo, stored as a downscaled PNG data URL (see readAvatarFile).
   * On the row rather than in localStorage, so an admin managing the team sees
   * every member's photo — the header's own avatar is per-browser, so it cannot
   * answer that question.
   */
  avatar         String?
  /** Contact number. Free text: it is display-only and never dialled. */
  phone          String?
  /** Job title / role description. */
  jobTitle       String?
  /** Free-form note an admin keeps about the person. */
  notes          String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id         String   @id @default(uuid())
  recipient  String
  type       String
  message    String
  clientId   String?
  clientName String?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([recipient, read])
  @@index([createdAt])
}

/// Key/value store for user-defined reference data: "channels", "statuses", "locations".
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model SyncRun {
  id             String    @id @default(uuid()) @db.Uuid
  provider       String
  direction      String
  status         String
  recordsRead    Int       @default(0)
  recordsWritten Int       @default(0)
  error          String?
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  @@index([provider, startedAt])
}

