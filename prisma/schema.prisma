generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AcquisitionChannel {
  FACEBOOK
  INSTAGRAM
  X
  TIKTOK
  GOOGLE_ADS
  WHATSAPP
  CALLS
  SALES
}

enum ClientStatus {
  WAITING
  WON
  LOST
}

model MarketingMetric {
  id         String             @id @default(uuid()) @db.Uuid
  startDate  DateTime           @db.Date
  endDate    DateTime           @db.Date
  channel    AcquisitionChannel
  spend      Decimal            @db.Decimal(12, 2)
  reach      Int                @default(0)
  impressions Int               @default(0)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  @@unique([startDate, endDate, channel])
  @@index([startDate, endDate])
  @@index([channel])
}

model Client {
  id                  String             @id @default(uuid()) @db.Uuid
  createdAt            DateTime           @default(now())
  lastUpdateDate      DateTime           @updatedAt
  name                String
  phoneNumber         String
  status              ClientStatus       @default(WAITING)
  project             String
  location            String
  acquisitionChannel  AcquisitionChannel
  operationToTake     String             @db.Text
  firstContactPerson  String
  secondContactPerson String
  @@index([acquisitionChannel, createdAt])
  @@index([status])
  @@index([location])
  @@index([createdAt])
}

model SyncRun {
  id             String    @id @default(uuid()) @db.Uuid
  provider       String
  direction      String
  status         String
  recordsRead    Int       @default(0)
  recordsWritten Int       @default(0)
  error          String?
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  @@index([provider, startedAt])
}
