# Copy to .env and fill in your Postgres connection strings:
#   cp .env.example .env          # macOS / Linux
#   Copy-Item .env.example .env   # Windows PowerShell
#
# TWO connections are required, because Prisma needs both:
#
#   DATABASE_URL          pooled  (host contains "-pooler")  -> used by the app at runtime
#   DATABASE_URL_UNPOOLED direct  (host has no "-pooler")    -> used by the Prisma CLI only
#                                                             (db push / migrate / db pull)
#
# The split matters: PgBouncer (the pooler) does not support the session state
# that the Prisma CLI needs, which is why migrations must bypass it.
#
# prisma/schema.prisma reads exactly these two names, so do not rename them.
# Note: the Neon Vercel integration injects both of these automatically, so on
# Vercel there is nothing to configure by hand.

# Pooled connection -- the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&connect_timeout=30"

# Direct (unpooled) connection -- Prisma CLI only.
# connect_timeout absorbs the delay while a scale-to-zero Neon compute wakes up.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require&connect_timeout=30"

# ── Google Sheets client import ─────────────────────────────────────────────
# The "Import from Google Sheet" button (admin only) on the clients view reads
# this public sheet. Both values are optional: the defaults below are baked into
# src/lib/google-sheet.ts, so the button works with no configuration at all.
# Set them to point at a different workbook or tab.
#
# GOOGLE_SHEET_ID is the id in /spreadsheets/d/<THIS_PART>/edit
# GOOGLE_SHEET_GID is the tab id from the #gid=... fragment of the sheet URL.
GOOGLE_SHEET_ID="1_sVksl-_b8KerzZ2hyKaShMYDJQkKh6Z"
GOOGLE_SHEET_GID="1879689378"